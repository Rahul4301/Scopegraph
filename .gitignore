.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# benchmark data and cloned benchmark repositories are local, never committed
data/
third_party/

# local caches and stores (embeddings, Mem0 vector stores); never results
.cache/

# leftovers from the previous project (untracked, kept locally)
.scopegraph/
.scopegraph-*.log
results/audit-report/
results/batches/
results/neo4j-live-report/
results/reports/
results/smoke/
results/raw/*.json
results/raw/*.jsonl

# macOS
.DS_Store
**/.DS_Store

# Supermemory self-hosted server data (holds its API key and an embedding plan)
.supermemory/

# everything under results/ (already-tracked files such as ledger.jsonl and phase0/ stay tracked)
results/*
