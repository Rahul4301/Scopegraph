# Copy to .env and fill in. .env is git-ignored and is never printed or logged.
# memstudy reads OPENAI_API_KEY (reader, judge, Mem0 extraction, embeddings) and, for arm D only,
# SUPERMEMORY_API_KEY.
OPENAI_API_KEY=
# Arm D only (self-hosted Supermemory): optional. The key is read from the server's data dir
# (.cache/supermemory/api-key); this variable is only a fallback when that file is missing.
SUPERMEMORY_API_KEY=
